{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["es2024", "es2025.regexp", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "incremental": true,
    "tsBuildInfoFile": ".tsbuildinfo",
    "noEmit": true,
    "declaration": true,
    "composite": false,
    "types": ["node"],
    "paths": { "@cellajs/cli/infra": ["./src/infra/exports.ts"] }
  },
  "include": ["src", "tests", "index.ts", "index.js", "tsdown.config.ts"]
}
