{
  "name": "@cellajs/cli",
  "version": "0.7.5",
  "private": false,
  "license": "MIT",
  "description": "CLI for managing your monorepo and upgrading it with upstream Cella.",
  "repository": {
    "type": "git",
    "url": "https://github.com/cellajs/cella-cli"
  },
  "homepage": "https://cellajs.com",
  "author": "CellaJS <info@cellajs.com>",
  "engines": {
    "node": "26.x"
  },
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./bench": {
      "types": "./dist/bench.d.ts",
      "import": "./dist/bench.js"
    },
    "./style": {
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./drive": {
      "types": "./dist/drive.d.ts",
      "import": "./dist/drive.js"
    },
    "./a11y": {
      "types": "./dist/a11y.d.ts",
      "import": "./dist/a11y.js"
    },
    "./screenshots": {
      "types": "./dist/screenshots.d.ts",
      "import": "./dist/screenshots.js"
    },
    "./pentest": {
      "types": "./dist/pentest.d.ts",
      "import": "./dist/pentest.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "index.js",
    "README.md"
  ],
  "bin": {
    "cella": "index.js"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "start": "tsx index.ts",
    "clean": "rimraf ./dist",
    "build": "tsdown",
    "test-build": "pnpm run build && node index.js --help",
    "prepublishOnly": "pnpm run test:release",
    "check": "pnpm ts && pnpm biome check --write .",
    "ts": "tsgo --pretty",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:release": "pnpm run build && vitest run --config vitest.release.config.ts",
    "test:watch": "vitest",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@inquirer/core": "^12.1.0",
    "@inquirer/prompts": "^8.8.0",
    "@pierre/diffs": "^1.6.4",
    "axe-core": "^4.14.0",
    "commander": "^15.1.0",
    "ts-morph": "^28.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@evilmartians/lefthook": "^2.2.2",
    "@tailwindcss/node": "^4.3.5",
    "@types/node": "26.6.6",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "playwright": "^1.65.0",
    "rimraf": "^6.1.4",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cella",
    "cellajs",
    "cli",
    "sync",
    "template"
  ],
  "packageManager": "pnpm@11.28.7",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "perf",
          "refactor",
          "revert",
          "docs",
          "chore",
          "build",
          "ci",
          "style",
          "test"
        ]
      ],
      "header-max-length": [
        2,
        "always",
        120
      ],
      "body-max-line-length": [
        0,
        "always",
        200
      ],
      "footer-max-line-length": [
        0,
        "always",
        200
      ]
    }
  }
}
